 {
  "scene": "scene-ov-reasons",
  "cls": "kq-en",
  "text": "“The Looming Tower was obvious enough – the company was founded partly as a response to 9/11 and what Peter felt were the inevitable violations of civil liberties that would follow, and the context was valuable.”",
  "px": 45,
  "x": 197,
  "y": 529,
  "claim": "ov.qureshi_why_looming_tower",
  "first": 203.0,
  "last": 215.0,
  "at": "ov.b15"
 },
 {
  "scene": "scene-ov-reasons",
  "cls": "kq-zh",
  "text": "The Looming Tower 的用意很明显：公司创立，部分是为了回应 9/11，以及 Peter 认为随之而来、无可避免的对公民自由的侵犯；这段背景有用。",
  "px": 37,
  "x": 197,
  "y": 742,
  "claim": "ov.qureshi_why_looming_tower",
  "first": 203.0,
  "last": 215.0,
  "at": "ov.b15"
 },
 {
  "scene": "scene-ov-reasons",
  "cls": "source",
  "text": "Nabeel Qureshi, Reflections on Palantir, 2024",
  "px": 24,
  "x": 80,
  "y": 1000,
  "claim": "ov.qureshi_why_looming_tower",
  "first": 203.0,
  "last": 245.0,
  "at": "ov.b15"
 },
 {
  "scene": "scene-ov-reasons",
  "cls": "kq-en",
  "text": "“Mandatory reading included ‘The Looming Tower’ by Lawrence Wright, which highlighted the importance of understanding your adversary.”",
  "px": 45,
  "x": 192,
  "y": 587,
  "claim": "ov.agrawal_looming_mandatory",
  "first": 216.0,
  "last": 220.0,
  "at": "ov.b15"
 },
 {
  "scene": "scene-ov-reasons",
  "cls": "kq-zh",
