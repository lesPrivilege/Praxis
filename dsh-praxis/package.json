{
  "name": "dsh-praxis",
  "version": "0.3.0",
  "private": true,
  "description": "Praxis: working methods for design and writing, with a roster of linked sources and authored streams, served to agents as tools, resources and prompts, and kept in order from a DSH sidebar panel.",
  "type": "module",
  "main": "adapters/dsh.js",
  "exports": {
    ".": "./adapters/dsh.js",
    "./core": "./core/index.js",
    "./tools": "./adapters/tools.js",
    "./client": "./adapters/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "praxis": "adapters/cli.js",
    "praxis-mcp": "adapters/mcp.js"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "test": "node --test core/*.test.mjs adapters/*.test.mjs",
    "walkthrough": "node release/walkthrough.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "praxis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "files": [
    "core/*.js",
    "adapters/*.js",
    "locale/*.json",
    "kit/",
    "schemas/",
    "docs/",
    "layers.md",
    "objects.md",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "icon": "./icon.svg"
}
