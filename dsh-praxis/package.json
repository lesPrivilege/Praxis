{
  "name": "dsh-praxis",
  "version": "0.1.0",
  "private": true,
  "description": "Praxis: a bundle of working methods (Task, Writing, Design, Publish) with their sources, served to agents as tools and kept in order from a DSH sidebar panel.",
  "type": "module",
  "main": "adapters/dsh.js",
  "exports": {
    ".": "./adapters/dsh.js",
    "./core": "./core/index.js",
    "./tools": "./adapters/tools.js",
    "./client": "./adapters/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "bin": {
    "praxis": "adapters/cli.js",
    "praxis-mcp": "adapters/mcp.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "node --test core/*.test.mjs adapters/*.test.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "praxis"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "files": [
    "core/*.js",
    "adapters/*.js",
    "ui/",
    "locale/*.json",
    "docs",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "icon": "./icon.svg"
}
