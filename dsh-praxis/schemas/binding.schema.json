{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "binding.schema.json",
  "title": "Binding",
  "description": "一个来源挂到一个单元上的关系与它的维护信息。来源包可以声明关系，名册里新建、移除、恢复的关系与维护信息记在数据根的 bindings.json。素材第 1 级（目录行）与第 3 级（取用题解）。",
  "type": "object",
  "required": [
    "id",
    "source",
    "target",
    "description",
    "enabled",
    "favorite",
    "priority",
    "state",
    "revision"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "source": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "target": {
      "$ref": "common.schema.json#/$defs/repoPath",
      "description": "挂载到的页面：包内 Kit 页写 kit/…，其他页写相对 base 的路径或绝对路径"
    },
    "description": {
      "$ref": "common.schema.json#/$defs/description"
    },
    "usage": {
      "type": "object",
      "description": "取用题解",
      "required": [
        "problem",
        "how"
      ],
      "properties": {
        "problem": {
          "type": "string",
          "description": "适用的问题"
        },
        "how": {
          "type": "string",
          "description": "怎样取用"
        },
        "conditions": {
          "type": "string"
        },
        "limits": {
          "type": "string",
          "description": "不适用或容易误用的情形"
        },
        "examples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "enabled": {
      "type": "boolean",
      "description": "进入任务默认可选范围"
    },
    "favorite": {
      "type": "boolean"
    },
    "priority": {
      "enum": [
        "preferred",
        "normal"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state": {
      "enum": [
        "active",
        "removed"
      ],
      "description": "删除即 removed，可撤销"
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/review"
      }
    },
    "revision": {
      "$ref": "common.schema.json#/$defs/revision"
    },
    "history": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/change"
      }
    }
  },
  "additionalProperties": false
}
