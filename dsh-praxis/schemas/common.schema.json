{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "common.schema.json",
  "title": "dsh-praxis 共用定义",
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:@._-]*$"},
    "revision": {"type": "integer", "minimum": 1, "description": "每次修改加一；写入时以 expected_revision 比对"},
    "repoPath": {"type": "string", "pattern": "^[^/~][^\\s]*$", "description": "相对仓库根目录的路径"},
    "description": {"type": "string", "minLength": 1, "maxLength": 240, "description": "入口级说明：何时用、产出什么、何时继续展开"},
    "change": {
      "type": "object",
      "required": ["revision", "by", "reason"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision"},
        "by": {"type": "string", "description": "操作者，人或 agent 的名称"},
        "task": {"type": "string", "description": "所属任务或运行"},
        "example": {"type": "string", "description": "依据的操作范例或规则版本"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["revision", "by", "verdict"],
      "properties": {
        "revision": {"$ref": "#/$defs/revision", "description": "被检查的版本"},
        "by": {"type": "string"},
        "verdict": {"enum": ["accurate", "revised", "needs-work"]},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
