          {
            "id": "B",
            "cost": 3,
            "value": 4
          },
          {
            "id": "C",
            "cost": 4,
            "value": 5
          }
        ],
        "budget": 5
      },
      "expected": {
        "value": 7,
        "selected": [
          "A",
          "B"
        ],
        "dp_rows": [
          [
            0,
            0,
            0,
            0,
            0,
            0
          ],
          [
            0,
            0,
            3,
            3,
            3,
            3
          ],
          [
            0,
            0,
            3,
            4,
            4,
            7
          ],
          [
            0,
            0,
            3,
            4,
            5,
            7
          ]
        ],
        "branch_c_upper_bound": 6.5
      },
      "invariant": "每件至多一次；界须乐观且有效"
    },
    {
      "id": "FDN:example:greedy",
      "chapter": "06-choices-and-optimization.md",
      "case_ids": [
        "V20"
      ],
      "input": {
        "intervals": [
          [
            "A",
            0,
            3
          ],
          [
            "B",
            2,
            4
          ],
          [
            "C",
            3,
            5
          ],
          [
            "D",
            5,
            7
          ]
        ]
      },
      "expected": {
        "max_count_ids": [
          "A",
          "C",
          "D"
        ]
      },
      "variants": [
        {
          "values": {
            "A": 1,
            "B": 100,
            "C": 1,
            "D": 1
          },
          "best_ids": [
            "B",
            "D"
          ],
          "best_value": 101
        }
      ],
      "invariant": "最早结束策略仅在此等价值最大数量题有保证"
    },
    {
      "id": "FDN:example:backtracking",
      "chapter": "06-choices-and-optimization.md",
      "case_ids": [
        "V19"
      ],
      "input": {
        "eligible": {
          "J1": [
            "甲",
            "乙"
          ],
          "J2": [
            "甲"
          ]
        }
      },
      "trace": [
        {
          "assign": {
            "J1": "甲"
          },
          "remaining_J2": []
        },
        {
          "backtrack": "J1"
        },
        {
          "assign": {
            "J1": "乙",
            "J2": "甲"
          }
        }
      ],
      "expected": {
        "assignment": {
          "J1": "乙",
          "J2": "甲"
        }
      },
      "invariant": "同一时段每人至多承担一项"
    },
    {
      "id": "FDN:example:caches",
      "chapter": "07-reuse-and-invalidation.md",
      "case_ids": [
        "H07",
        "H09",
        "X01"
      ],
      "input": {
        "capacity": 2,
        "requests": [
          "A",
          "A",
          "B",
          "A",
          "C",
          "B"
        ],
        "lfu_tie_rule": "LRU",
        "lfu_count_scope": "驻留期间"
      },
      "expected": {
        "lru_keys_old_to_new": [
          "C",
          "B"
        ],
        "lfu_keys": [
          "A",
          "B"
        ],
        "lru_hits": 2,
        "lru_misses": 4,
        "lfu_hits": 2,
        "lfu_misses": 4
      },
      "invariant": "精确教学策略，不声称 Redis 淘汰顺序",
      "variants": [
        {
          "name": "seventh request A",
          "input": {
            "requests": [
              "A",
              "A",
              "B",
              "A",
              "C",
              "B",
              "A"
            ],
            "capacity": 2
          },
          "expected": {
            "lru_keys_old_to_new": [
              "B",
              "A"
            ],
            "lfu_keys": [
              "A",
              "B"
            ],
            "lru_hits": 2,
            "lru_misses": 5,
            "lfu_hits": 3,
            "lfu_misses": 4
          }
        }
      ]
    },
    {
      "id": "FDN:example:bloom",
      "chapter": "08-approximation-and-search.md",
      "case_ids": [
        "V04",
        "V12"
      ],
      "input": {
        "m": 8,
        "hash_positions": {
          "A": [
            1,
            4
          ],
          "B": [
            4,
            6
          ],
          "C": [
            1,
            6
          ],
          "D": [
            2,
            6
          ]
        },
        "inserted": [
          "A",
          "B"
        ]
      },
      "expected": {
        "set_bits": [
          1,
          4,
          6
        ],
        "possibly_present_C": true,
        "possibly_present_D": false
      },
      "invariant": "阳性必须精确核对；本例为固定合成 hash"
    },
    {
      "id": "FDN:example:hll",
      "chapter": "08-approximation-and-search.md",
      "case_ids": [
        "H07",
        "X01"
      ],
      "input": {
        "register_count": 4,
        "hashes": [
          "00|0011",
          "00|0111",
          "00|0011",
          "10|0001"
        ]
      },
      "expected": {
        "registers": [
          3,
          0,
          4,
          0
        ]
      },
      "invariant": "仅演示寄存器更新；不把四桶示意当作生产基数估计"
    },
    {
      "id": "FDN:example:ann",
      "chapter": "08-approximation-and-search.md",
      "case_ids": [
        "H06",
        "V18"
      ],
      "input": {
        "query": [
          0,
          0
        ],
        "vectors": {
          "A": [
            1,
            0
          ],
          "B": [
            0,
            2
          ],
          "C": [
            3,
            0
          ],
          "D": [
            4,
            0
          ]
        },
        "candidate_ids": [
          "A",
          "C",
          "D"
        ],
        "k": 2
      },
      "expected": {
        "exact_top": [
          "A",
          "B"
        ],
        "approximate_top": [
          "A",
          "C"
        ],
        "recall": 0.5
      },
      "invariant": "候选过程是假设，未运行 ANN 索引",
      "input_contract": "All coordinates finite numeric and same positive dimension; candidates unique known IDs; integer 1<=k<=vector count."
    },
    {
      "id": "FDN:example:recovery",
      "chapter": "09-from-ui-to-recovery.md",
      "case_ids": [
        "V04",
        "V12"
      ],
      "input": {
        "operation": "OP7",
        "tenant": "A",
        "object": "S3",
        "expected_version": 2,
        "refund_amount": 40
      },
      "trace": [
        {
          "step": "local_commit",
          "object_version": 3,
          "operation_state": "awaiting_external",
          "outbox_exists": true
        },
        {
          "step": "external_accept_response_lost",
          "operation_state": "unknown"
        },
        {
          "step": "reconcile_same_operation",
          "operation_state": "confirmed",
          "external_id": "R1",
          "effect_count": 1
        }
      ],
      "expected": {
        "refund_total": 40,
        "effect_count": 1
      },
      "invariant": "超时后核对原尝试，不生成新逻辑退款"
    },
    {
      "id": "FDN:example:ai-eval",
      "chapter": "10-verification-and-evals.md",
      "case_ids": [
        "H06",
        "X01"
      ],
      "input": {
        "tp": 18,
        "fn": 2,
        "fp": 4,
        "tn": 16
      },
      "expected": {
        "n": 40,
        "precision_fraction": [
          18,
          22
        ],
        "recall_fraction": [
          18,
          20
        ],
        "accuracy_fraction": [
          34,
          40
        ]
      },
      "invariant": "合成混淆矩阵；没有调用模型",
      "input_contract": "Nonnegative integer confusion counts; a zero denominator returns null for that metric.",
      "variants": [
        {
          "name": "1 percent prevalence with hypothetical stable conditional rates",
          "input": {
            "tp": 9,
            "fn": 1,
            "fp": 198,
            "tn": 792
          },
          "expected": {
            "n": 1000,
            "precision_fraction": [
              9,
              207
            ],
            "recall_fraction": [
              9,
              10
            ],
            "accuracy_fraction": [
              801,
              1000
            ]
          }
        }
      ]
    }
  ]
}
