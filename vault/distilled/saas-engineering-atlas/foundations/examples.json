{
  "schema_version": "1.0-local",
  "namespace": "FDN",
  "synthetic": true,
  "scope": "教学输入、状态步与期望值；无布局、坐标、动效或 UI 指定",
  "examples": [
    {
      "id": "FDN:example:order",
      "chapter": "01-problems-and-objects.md",
      "case_ids": [
        "H01",
        "V04",
        "V20"
      ],
      "input": {
        "ordered": 3,
        "unit_price": 40,
        "delivered": 2,
        "pending": 1,
        "cancelled": 0
      },
      "trace": [
        {
          "action": "cancel_pending",
          "delivered": 2,
          "pending": 0,
          "cancelled": 1,
          "refund_due": 40,
          "refund_confirmed": 0
        }
      ],
      "expected": {
        "quantity_total": 3,
        "refund_due": 40
      },
      "invariant": "delivered + pending + cancelled = ordered；refund_due 与 confirmed 分开"
    },
    {
      "id": "FDN:example:lookup",
      "chapter": "02-lookup-and-indexes.md",
      "case_ids": [
        "H01",
        "V03",
        "X01"
      ],
      "input": {
        "keys": [
          [
            "A",
            "O7"
          ],
          [
            "A",
            "O9"
          ],
          [
            "B",
            "O7"
          ]
        ],
        "teaching_buckets": [
          2,
          2,
          5
        ],
        "sorted_days": [
          2,
          5,
          8,
          12,
          17
        ],
        "threshold": 9,
        "trie_words": [
          "car",
          "cart",
          "cat",
          "dog"
        ],
        "prefix": "ca",
        "btree": {
          "keys": [
            10,
            20
          ],
          "children": [
            {
              "keys": [
                2,
                5
              ]
            },
            {
              "keys": [
                12,
                17
              ]
            },
            {
              "keys": [
                23,
                29
              ]
            }
          ]
        },
        "btree_target": 17,
        "btree_range": [
          12,
          24
        ]
      },
      "expected": {
        "lower_bound_value": 12,
        "prefix_matches": [
          "car",
          "cart",
          "cat"
        ],
        "btree_visited": [
          [
            10,
            20
          ],
          [
            12,
            17
          ]
        ],
        "btree_range_values": [
          12,
          17,
          20,
          23
        ]
      },
      "invariant": "完整 key 相等才为同对象；查找索引不能扩大授权范围"
    },
    {
      "id": "FDN:example:top-k",
      "chapter": "03-order-and-intervals.md",
      "case_ids": [
        "H03",
        "H06"
      ],
      "input": {
        "records": [
          [
            "A",
            70
          ],
          [
            "B",
            20
          ],
          [
            "C",
            70
          ],
          [
            "D",
            50
          ],
          [
            "E",
            90
          ]
        ],
        "k": 2,
        "order": "score DESC, id ASC"
      },
      "expected": {
        "sorted_ids": [
          "E",
          "A",
          "C",
          "D",
          "B"
        ],
        "top_ids": [
          "E",
          "A"
        ]
      },
      "invariant": "保留多重集；Top-K 与相同规则全排序前 k 项相同"
    },
    {
      "id": "FDN:example:two-pointers",
      "chapter": "03-order-and-intervals.md",
      "case_ids": [
        "H03",
        "X02"
      ],
      "input": {
        "amounts": [
          1,
          3,
          4,
          7,
          9
        ],
        "target": 11
      },
      "trace": [
        [
          1,
          9,
          10
        ],
        [
          3,
          9,
          12
        ],
        [
          3,
          7,
          10
        ],
        [
          4,
          7,
          11
        ]
      ],
      "expected": {
        "pair": [
          4,
          7
        ]
      },
      "invariant": "两笔必须来自不同记录；金额匹配仅产生候选"
    },
    {
      "id": "FDN:example:intervals",
      "chapter": "03-order-and-intervals.md",
      "case_ids": [
        "V11",
        "V19"
      ],
      "input": {
        "values": [
          2,
          1,
          3,
          0,
          4
        ],
        "width": 3,
        "range": [
          1,
          4
        ]
      },
      "expected": {
        "prefix": [
          0,
          2,
          3,
          6,
          6,
          10
        ],
        "rolling": [
          6,
          4,
          7
        ],
        "range_sum": 4
      },
      "variants": [
        {
          "values": [
            6,
            -3,
            2
          ],
          "budget": 5,
          "expected_longest_length": 3,
          "invalid_method": "非负前提下的超额立即缩左窗口"
        }
      ],
      "invariant": "sum[a,c) = sum[a,b) + sum[b,c)"
    },
    {
      "id": "FDN:example:graph",
      "chapter": "04-graphs-and-connectivity.md",
      "case_ids": [
        "H07",
        "V08"
      ],
      "input": {
        "nodes": [
          "A",
          "B",
          "C",
          "D",
          "E"
        ],
        "edges": [
          [
            "A",
            "B"
          ],
          [
            "A",
            "C"
          ],
          [
            "B",
            "D"
          ],
          [
            "C",
            "D"
          ],
          [
            "D",
            "E"
          ]
        ],
        "start": "A"
      },
      "expected": {
        "bfs_layers": [
          [
            "A"
          ],
          [
            "B",
            "C"
          ],
          [
            "D"
          ],
          [
            "E"
          ]
        ],
        "dfs_preorder": [
          "A",
          "B",
          "D",
          "E",
          "C"
        ]
      },
      "variants": [
        {
          "added_edge": [
            "E",
            "B"
          ],
          "cycle": [
            "B",
            "D",
            "E",
            "B"
          ]
        }
      ],
      "invariant": "计算边为前提→受影响对象；不改公共 depends_on 的语义方向"
    },
    {
      "id": "FDN:example:shortest-path",
      "chapter": "04-graphs-and-connectivity.md",
      "case_ids": [
        "V21"
      ],
      "input": {
        "edges": [
          [
            "A",
            "B",
            4
          ],
          [
            "A",
            "C",
            1
          ],
          [
            "C",
            "B",
            2
          ],
          [
            "B",
            "D",
            1
          ],
          [
            "C",
            "D",
            7
          ]
        ],
        "start": "A",
        "nodes": [
          "A",
          "B",
          "C",
          "D"
        ],
        "target": "D"
      },
      "expected": {
        "distances": {
          "A": 0,
          "B": 3,
          "C": 1,
          "D": 4
        },
        "path": [
          "A",
          "C",
          "B",
          "D"
        ]
      },
      "invariant": "本例权重为非负分钟"
    },
    {
      "id": "FDN:example:union-find",
      "chapter": "04-graphs-and-connectivity.md",
      "case_ids": [
        "V22"
      ],
      "input": {
        "nodes": [
          "A",
          "B",
          "C",
          "D"
        ],
        "unions": [
          [
            "A",
            "B"
          ],
          [
            "C",
            "D"
          ],
          [
            "B",
            "C"
          ]
        ]
      },
      "expected": {
        "component_counts": [
          4,
          3,
          2,
          1
        ]
      },
      "invariant": "仅无向增量连通；不支持直接删除连接或推出权限"
    },
    {
      "id": "FDN:example:dag",
      "chapter": "05-dependencies-and-queues.md",
      "case_ids": [
        "H09",
        "V09",
        "V20"
      ],
      "input": {
        "durations": {
          "A": 2,
          "B": 3,
          "C": 4,
          "D": 1
        },
        "predecessors": {
          "A": [],
          "B": [
            "A"
          ],
          "C": [
            "A"
          ],
          "D": [
            "B",
            "C"
          ]
        }
      },
      "expected": {
        "earliest_finish": {
          "A": 2,
          "B": 5,
          "C": 6,
          "D": 7
        },
        "one_shared_worker_finish": 10
      },
      "invariant": "全部前提完成才就绪；资源约束另算"
    },
    {
      "id": "FDN:example:optimization",
      "chapter": "06-choices-and-optimization.md",
      "case_ids": [
        "V07",
        "V19",
        "V21"
      ],
      "input": {
        "items": [
          {
            "id": "A",
