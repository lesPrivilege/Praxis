{
  "contract_version": "1.0",
  "identity_rules": {
    "case": "沿用 H01-H09、V01-V22、X01-X02，不因分包或标题变化重新编号。",
    "package": "P01-P06 仅表达写入所有权，不是行业或地域等级。",
    "node": "<case-id>:<node-type>:<slug>；系统内部运行 ID 另外记录。",
    "edge": "<case-id>:edge:<slug>",
    "claim": "<case-id>:claim:<slug>；外部已核查来源主张保留 <source-id>-C<n>。",
    "term": "TERM:<source-id>:<original-term-slug> 或 TERM:COMMON:<slug>；同义词显式 aliases，不能合并不同语义。",
    "transfer": "TR:<from-case>:<to-case>:<slug>；记录保留机制、前提、变化与反例，由父线程合并。",
    "check": "<case-id>:check:<slug>",
    "source": "保留种子 ID；新来源用 <package-id>-SRC-<slug>，父线程按 canonical URL 去重。"
  },
