  "lifecycles": [
    {
      "object_id": "V12:object:application",
      "states": [
        "draft",
        "review",
        "approved",
        "rejected",
        "superseded"
      ],
      "transitions": [
        {
          "from": "draft",
          "to": "review",
          "trigger": "送审",
          "guard": "资料完整且有权限",
          "durable_effect": "固定条款版本与请求 ID",
          "recovery": "缺资料返回 draft"
        },
        {
          "from": "review",
          "to": "draft",
          "trigger": "补资料",
          "guard": "审批员确认缺项",
          "durable_effect": "保存缺项及退回原因",
          "recovery": "原提交历史保留"
        },
        {
          "from": "review",
          "to": "approved",
          "trigger": "批准",
          "guard": "批准角色、版本一致、非申请人自批",
          "durable_effect": "批准证据与放款待办同事务",
          "recovery": "冲突重读，禁止套用旧批准"
        },
        {
          "from": "review",
          "to": "rejected",
          "trigger": "拒绝",
          "guard": "授权判断及理由",
          "durable_effect": "保存拒绝决定",
          "recovery": "重新申请用新版本"
        },
        {
          "from": "approved",
          "to": "superseded",
          "trigger": "批准后改条款",
          "guard": "创建新草案并撤销旧版待执行资格",
          "durable_effect": "旧版本及替代关系",
          "recovery": "已执行资金仍按原记录核对"
        }
      ]
    },
    {
      "object_id": "V12:object:disbursement",
      "states": [
        "prepared",
        "submitted",
        "unknown",
        "settled",
        "failed"
      ],
      "transitions": [
        {
          "from": "prepared",
          "to": "submitted",
          "trigger": "发起银行请求",
          "guard": "批准版本有效且操作已持久化",
          "durable_effect": "固定参考号与请求摘要",
          "recovery": "进程退出后先查询是否已发送"
        },
        {
          "from": "submitted",
          "to": "unknown",
          "trigger": "超时",
          "guard": "未能确定执行结果",
          "durable_effect": "保留原操作占位",
          "recovery": "查询原参考号，不新建转账"
        },
        {
          "from": "submitted",
          "to": "settled",
          "trigger": "银行确认",
