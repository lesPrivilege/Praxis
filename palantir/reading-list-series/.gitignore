# Generated media and caches: rebuilt by build/*.py, kept out of Git.
out/*
!out/README.md
# Downloaded external images: re-fetched and hash-checked by build/fetch_assets.py from research/assets.jsonl.
assets/files/*
!assets/files/README.md
# Cover previews are rendered from the SVG sources by build/cover.py.
episodes/*/covers/*.png
assembly/covers/*.png
